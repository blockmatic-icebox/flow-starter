# Copy to repository-root `.env` (gitignored). Pick ONE database path — see
# docs/initiatives/feature-intelligence.md § Plan — Postgres / Neon connectivity

# --- Path A (recommended): direct Neon branch ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require

# --- Path B: Neon Local via Docker (pnpm db:start) ---
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional: branch to fork ephemeral local branches from (default branch if unset)
# PARENT_BRANCH_ID=

# When using Path B and DATABASE_URL is unset, migrate/ping/seed use:
# postgres://neon:npg@localhost:5432/neondb?sslmode=require

# Development only. Local Neon proxy: scripts set this for localhost URLs.
# DATABASE_TLS_INSECURE_LOCAL=1
