# Neon Local (Docker proxy) — required for pnpm db:start
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional: branch to fork ephemeral local branches from (default branch if unset)
# PARENT_BRANCH_ID=

# Preview / production (Neon console or Vercel integration)
# DATABASE_URL=postgresql://...

# Development only. Set to 1 so local scripts can accept the Neon Local proxy certificate.
# Ignored when NODE_ENV=production. Remote databases stay certificate-validating.
# DATABASE_TLS_INSECURE_LOCAL=1
