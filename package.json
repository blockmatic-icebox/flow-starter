{
  "name": "flow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter web dev",
    "setup": "pnpm i && pnpm setup:env",
    "setup:full": "pnpm setup && pnpm skills:install && pnpm setup:gitleaks && pnpm setup:osv && pnpm setup:portless && pnpm setup:deepsec && pnpm setup:playwright",
    "setup:playwright": "pnpm --filter web exec playwright install chromium && pnpm --filter flow-app exec playwright install chromium",
    "dev:web": "pnpm --filter web dev",
    "dev:flow": "pnpm --filter flow-app dev",
    "dev:all": "turbo run dev --filter=web --filter=flow-app",
    "build:web": "pnpm --filter web build",
    "build:flow": "pnpm --filter flow-app build",
    "test:browser:web": "pnpm --filter web test:browser",
    "test:browser:flow": "pnpm --filter flow-app test:browser",
    "setup:portless": "portless trust && portless proxy start",
    "setup:gitleaks": "node scripts/setup-gitleaks.mjs",
    "setup:osv": "node scripts/setup-osv-scanner.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:deepsec": "pnpm --dir=.deepsec install --frozen-lockfile",
    "ci:local": "pnpm qa && pnpm flow:test && pnpm architecture:test && pnpm test:scripts && pnpm eval:genui:offline && pnpm test:browser && pnpm security:check && pnpm build",
    "eval:genui:offline": "pnpm --filter @repo/genui eval:offline",
    "hooks:pre-commit": "pnpm security:block-files && pnpm security:secrets && node scripts/check-staged.mjs",
    "prepare": "simple-git-hooks",
    "qa": "pnpm flow:check && pnpm architecture:check && pnpm lint && pnpm knip && pnpm sherif && pnpm check-types && pnpm test && pnpm --filter @repo/db db:check",
    "flow:check": "node scripts/check-flow-docs.mjs",
    "flow:test": "node --test scripts/check-flow-docs.test.mjs",
    "architecture:check": "node scripts/check-react-architecture.mjs",
    "architecture:test": "node --test scripts/check-react-architecture.test.mjs",
    "test": "pnpm --filter @repo/genui test && pnpm --filter flow-app test && pnpm --filter @repo/db test",
    "test:browser": "pnpm test:browser:web && pnpm test:browser:flow",
    "test:scripts": "node --test scripts/*.test.mjs tests/security/*.test.mjs",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write --no-error-on-unmatched-pattern .",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "sherif": "sherif",
    "security:block-files": "node scripts/block-secret-files.mjs",
    "security:secrets": "node scripts/scan-secrets-staged.mjs",
    "security:secrets:full": "gitleaks detect --redact --config .gitleaks.toml",
    "security:osv": "node scripts/scan-osv.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "security:check": "node scripts/security-check.mjs",
    "security:deepsec:scan": "pnpm --dir=.deepsec exec deepsec scan",
    "security:deepsec:process:diff": "pnpm --dir=.deepsec exec deepsec process --agent pi --model xai/grok-4.6 --thinking-level medium --diff origin/main",
    "security:deepsec:report": "pnpm --dir=.deepsec exec deepsec report",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:ping": "node scripts/db-ping.mjs",
    "update-deps": "node scripts/update-deps.mjs",
    "deepsec": "pnpm --dir=.deepsec exec deepsec",
    "skills:install": "pnpm exec skills experimental_install",
    "skills:update": "pnpm exec skills update -p -y",
    "mcp:next": "next-devtools-mcp"
  },
  "devDependencies": {
    "@repo/db": "workspace:*",
    "knip": "^6.41.0",
    "next-devtools-mcp": "0.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "portless": "^0.15.8",
    "sherif": "^1.13.0",
    "simple-git-hooks": "2.14.0",
    "skills": "1.7.2",
    "tsc-ts": "^0.0.2",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.8.3",
    "ultracite": "8.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run hooks:pre-commit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
