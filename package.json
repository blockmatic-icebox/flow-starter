{
  "name": "flow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter web dev",
    "setup": "pnpm i && pnpm setup:env",
    "setup:full": "pnpm setup && pnpm skills:install && pnpm setup:gitleaks && pnpm setup:osv && pnpm setup:portless && pnpm setup:deepsec && pnpm setup:playwright",
    "setup:playwright": "pnpm --filter web exec playwright install chromium",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test:browser:web": "pnpm --filter web test:browser",
    "setup:portless": "portless trust && portless proxy start",
    "setup:gitleaks": "pnpm --dir .agents setup:gitleaks",
    "setup:osv": "pnpm --dir .agents setup:osv",
    "setup:env": "pnpm --dir .agents setup:env",
    "setup:deepsec": "pnpm --dir=.deepsec install --frozen-lockfile",
    "ci:local": "pnpm qa && pnpm commits:check --all && pnpm --dir .agents test && pnpm eval:genui:offline && pnpm test:browser && pnpm security:check && pnpm build",
    "eval:genui:offline": "pnpm --filter @repo/genui eval:offline",
    "flow-eval:check": "pnpm --dir .agents flow-eval:check",
    "eval:experiment": "pnpm --dir .agents eval:experiment",
    "eval:self-improve": "pnpm --dir .agents eval:self-improve",
    "eval:readiness": "pnpm --dir .agents eval:readiness",
    "eval:stress": "pnpm --dir .agents eval:stress",
    "eval:mutations": "pnpm --dir .agents eval:mutations",
    "eval:benchmark": "pnpm --dir .agents eval:benchmark",
    "eval:benchmark:checkout": "pnpm --dir .agents eval:benchmark:checkout",
    "hooks:pre-commit": "pnpm security:block-files && pnpm security:secrets && node .agents/tooling/checks/check-staged.mjs",
    "hooks:commit-msg": "node .agents/tooling/checks/check-commit-message.mjs",
    "commits:check": "node .agents/tooling/checks/check-commits.mjs",
    "prepare": "simple-git-hooks",
    "qa": "pnpm flow:check && pnpm architecture:check && pnpm lint && pnpm knip && pnpm sherif && pnpm check-types && pnpm test && pnpm --filter @repo/db db:check",
    "flow:check": "pnpm --dir .agents flow:check",
    "flow:test": "pnpm --dir .agents flow:test",
    "worktrees": "pnpm --dir .agents worktrees",
    "architecture:check": "pnpm --dir .agents architecture:check",
    "architecture:test": "pnpm --dir .agents architecture:test",
    "test": "pnpm --filter @repo/genui test && pnpm --filter web test && pnpm --filter @repo/db test",
    "test:browser": "pnpm test:browser:web",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write --no-error-on-unmatched-pattern .",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "sherif": "sherif",
    "security:block-files": "pnpm --dir .agents security:block-files",
    "security:secrets": "pnpm --dir .agents security:secrets",
    "security:secrets:full": "gitleaks detect --redact --config .gitleaks.toml",
    "security:osv": "pnpm --dir .agents security:osv",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:check": "pnpm --dir .agents security:check",
    "security:deepsec:scan": "pnpm --dir=.deepsec exec deepsec scan",
    "security:deepsec:process:diff": "pnpm --dir=.deepsec exec deepsec process --agent pi --model xai/grok-4.6 --thinking-level medium --diff origin/main",
    "security:deepsec:report": "pnpm --dir=.deepsec exec deepsec report",
    "db:start": "node packages/db/scripts/db-start.mjs",
    "db:stop": "node packages/db/scripts/db-stop.mjs",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:ping": "node packages/db/scripts/db-ping.mjs",
    "update-deps": "pnpm --dir .agents update-deps",
    "deepsec": "pnpm --dir=.deepsec exec deepsec",
    "skills:install": "pnpm exec skills experimental_install",
    "skills:update": "pnpm exec skills update -p -y",
    "mcp:next": "next-devtools-mcp"
  },
  "devDependencies": {
    "knip": "^6.42.1",
    "next-devtools-mcp": "0.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "portless": "^0.15.10",
    "sherif": "^1.13.0",
    "simple-git-hooks": "2.14.0",
    "skills": "1.7.4",
    "tsc-ts": "^0.0.9",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.8.3",
    "ultracite": "8.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run hooks:pre-commit",
    "commit-msg": "node .agents/tooling/checks/check-commit-message.mjs \"$1\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
