{
  "name": "flow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "setup": "pnpm setup:portless",
    "setup:portless": "portless trust && portless proxy start",
    "ci:local": "pnpm flow:test && pnpm flow:check && pnpm architecture:test && pnpm architecture:check && pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "hooks:pre-commit": "pnpm qa",
    "prepare": "simple-git-hooks",
    "qa": "pnpm flow:check && pnpm architecture:check && pnpm lint && pnpm check-types && pnpm test",
    "flow:check": "node scripts/check-flow-docs.mjs",
    "flow:test": "node --test scripts/check-flow-docs.test.mjs",
    "architecture:check": "node scripts/check-react-architecture.mjs",
    "architecture:test": "node --test scripts/check-react-architecture.test.mjs",
    "test": "pnpm --filter @repo/genui test",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write --no-error-on-unmatched-pattern .",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .",
    "check-types": "turbo run check-types",
    "deepsec": "pnpm --dir=.deepsec exec deepsec",
    "skills:install": "pnpm exec skills experimental_install",
    "skills:update": "pnpm exec skills update -p -y",
    "mcp:next": "next-devtools-mcp"
  },
  "devDependencies": {
    "next-devtools-mcp": "0.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "portless": "^0.15.8",
    "simple-git-hooks": "2.14.0",
    "skills": "1.7.2",
    "tsc-ts": "^0.0.2",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.8.3",
    "ultracite": "8.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run hooks:pre-commit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
