# Ask-only /chat — direct Anthropic (local dev; already configured in many setups)
ANTHROPIC_API_KEY=
# Optional override (default claude-sonnet-4-20250514)
# FI_CHAT_MODEL=

# Triage harness (@repo/fi) — Jev + synthesis via Vercel AI Gateway only
# Ask Hunch tier-3 compose also uses AI_GATEWAY_API_KEY when set
AI_GATEWAY_API_KEY=
# GENUI_MODEL=anthropic/claude-sonnet-4.6
# FI_DECISION_MODEL=typesafe-ai/jev
# FI_SYNTHESIS_MODEL=anthropic/claude-sonnet-4.6

# Database — set in repo-root `.env` (Path A direct URL, or Path B after pnpm db:start)
# DATABASE_URL=
