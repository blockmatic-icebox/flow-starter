# Optional: tier-3 open-ended answers and consultant chat via Vercel AI Gateway.
# Without this key, chat and tier 3 stay on the deterministic fallback.
# AI_GATEWAY_API_KEY=
# GENUI_MODEL=anthropic/claude-sonnet-4
# CONSULTANT_MODEL=anthropic/claude-sonnet-4

# Production origin used by MCP host checks. Example: https://app.example
# APP_ORIGIN=
# CONSULTANT_MCP_BEARER=
# CONSULTANT_MCP_PUBLIC_READ_ONLY=0
# CONSULTANT_MCP_ALLOWED_ORIGINS=

# Production rate limits. Required when NODE_ENV=production.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Required in production: header your ingress overwrites (for example x-real-ip).
# Without it, compose and chat fail closed with 503.
# RATE_LIMIT_TRUSTED_IP_HEADER=x-real-ip
# GENUI_ENFORCE_RATE_LIMIT=
