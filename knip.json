{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "namespaceMembers": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "off",
    "unlisted": "error",
    "unresolved": "error"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/worktrees.mjs",
        "scripts/worktrees/**/*.mjs",
        "scripts/*.{mjs,ts}",
        "scripts/**/*.test.mjs",
        "tests/**/*.test.mjs",
        "oxlint.config.ts"
      ],
      "project": ["scripts/**/*.{mjs,ts}", "tests/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "tests/**/*.test.ts",
        "tests/**/*.spec.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "apps/flow": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "app/_components/**/*.{ts,tsx}",
        "app/_lib/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "packages/genui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "drizzle.config.ts", "scripts/**/*.mjs"]
    },
    "packages/ts": {
      "entry": [],
      "project": []
    },
    "packages/flow-eval": {
      "entry": ["src/cli.ts", "src/**/*.test.ts", "src/product/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    ".agents/skills/**",
    "packages/ui/src/components/**",
    "packages/genui/src/fixtures/**",
    "packages/db/auth.config.ts"
  ],
  "ignoreUnresolved": ["next"],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "better-auth",
    "next-themes",
    "postcss-load-config",
    "zod"
  ],
  "ignoreBinaries": ["simple-git-hooks", "gitleaks", "osv-scanner", "deepsec"]
}
