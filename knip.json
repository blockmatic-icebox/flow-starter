{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "namespaceMembers": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "off",
    "unlisted": "error",
    "unresolved": "error"
  },
  "workspaces": {
    ".": {
      "entry": [
        "oxlint.config.ts",
        ".agents/tooling/worktrees/worktrees.mjs",
        ".agents/tooling/worktrees/**/*.mjs",
        ".agents/tooling/**/*.{mjs,ts}",
        ".agents/tooling/**/*.test.mjs"
      ],
      "project": [".agents/tooling/**/*.{mjs,ts}", "oxlint.config.ts"]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "tests/**/*.test.ts",
        "tests/**/*.spec.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "packages/genui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "drizzle.config.ts", "scripts/**/*.mjs"]
    },
    "packages/ts": {
      "entry": ["base.json", "nextjs.json", "react-library.json"],
      "project": ["*.json"]
    }
  },
  "ignore": [
    ".agents/skills/**",
    "packages/ui/src/components/**",
    "packages/genui/src/fixtures/**",
    "packages/db/auth.config.ts"
  ],
  "ignoreUnresolved": ["next"],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "better-auth",
    "next-themes",
    "postcss-load-config",
    "zod"
  ],
  "ignoreBinaries": ["simple-git-hooks", "gitleaks", "osv-scanner", "deepsec"]
}
