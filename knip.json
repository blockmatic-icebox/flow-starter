{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "namespaceMembers": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "off",
    "unlisted": "error",
    "unresolved": "error"
  },
  "workspaces": {
    ".": {
      "entry": [
        "oxlint.config.ts",
        "tooling/**/*.{mjs,ts}",
        "tooling/**/*.test.mjs",
        "agent/**/*.ts",
        "evals/**/*.ts"
      ],
      "project": [
        "tooling/**/*.{mjs,ts}",
        "oxlint.config.ts",
        "agent/**/*.ts",
        "evals/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "tests/**/*.test.ts",
        "tests/**/*.spec.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs}"]
    },
    "packages/genui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "drizzle.config.ts", "scripts/db-ping.mjs"],
      "project": ["src/**/*.ts", "drizzle.config.ts", "scripts/**/*.mjs"]
    },
    "packages/fi": {
      "entry": [
        "src/**/*.ts",
        "seed/**/*.ts",
        "eval/**/*.ts",
        "eval/smoke-cli.ts"
      ],
      "project": ["src/**/*.ts", "seed/**/*.ts", "eval/**/*.ts"]
    },
    "packages/ts": {
      "entry": ["base.json", "nextjs.json", "react-library.json"],
      "project": ["*.json"]
    }
  },
  "ignore": [
    ".agents/skills/**",
    "packages/ui/src/components/**",
    "packages/genui/src/fixtures/**",
    "packages/db/auth.config.ts"
  ],
  "ignoreUnresolved": ["next"],
  "ignoreDependencies": [
    "@ai-sdk/gateway",
    "@repo/db",
    "typescript-ast",
    "@tailwindcss/postcss",
    "better-auth",
    "drizzle-orm",
    "next-themes",
    "postcss-load-config",
    "postgres",
    "zod",
    "ai",
    "eve"
  ],
  "ignoreBinaries": ["simple-git-hooks", "gitleaks", "osv-scanner", "deepsec"]
}
